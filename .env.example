

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8000/api/v1/auth/facebook/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# AWS SES (forgot password). Leave SES_FROM_EMAIL empty to log the reset link instead
AWS_REGION=ap-southeast-1
SES_FROM_EMAIL=

# reCAPTCHA v3 (để trống thì bỏ qua verify)
RECAPTCHA_SECRET_KEY=

# TOTP 2FA: openssl rand -base64 32
TOTP_ENC_KEY=

# Daily English (bài từ vựng hằng ngày, không bắt buộc)
# DAILY_GATE_TODAY=2026-11-05 để giả lập ngày khi thử (dev)

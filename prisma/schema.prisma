generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════ M1: Auth ═══════
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String? // null nếu đăng ký qua social
  displayName     String?
  avatarUrl       String?
  role            Role      @default(USER)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts       Account[]
  profile        UserProfile?
  refreshTokens  RefreshToken[]
  loginHistory   LoginHistory[]
  totp           UserTotp?
  securityEvents SecurityEvent[]
  todos          Todo[]
  dailyProgress  UserDailyProgress[]
  wordReviews    WordReview[]
  phrases        Phrase[]
  phraseActivity PhraseActivityDay[]
  articles       Article[]
  comments       Comment[]
  reactions      Reaction[]
  bookmarks      Bookmark[]
  topicFollows   TopicFollow[]
  pathProgress   UserPathProgress[]
  stepProgress   UserStepProgress[]
}

enum Role {
  USER
  CREATOR
  ADMIN
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String // "google", "facebook", "github"
  providerAccountId String
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// token lưu dạng sha256 hash, không lưu token gốc
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════ Dev tooling ═══════
model DevTodo {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(255)
  status      String    @default("pending") // pending | in_progress | done
  priority    String    @default("medium") // low | medium | high
  category    String    @default("Backend")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
}

// ═══════ M2: User profile (settings) ═══════
model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  displayName  String?  @db.VarChar(100)
  bio          String?  @db.VarChar(500)
  phone        String?  @db.VarChar(20)
  avatarBase64 String?  @db.Text
  timezone     String   @default("Asia/Ho_Chi_Minh")
  locale       String   @default("vi")
  theme        String   @default("system")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ip        String
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, ip])
}

model UserTotp {
  id           String    @id @default(uuid())
  userId       String    @unique
  secretEnc    String // AES-256-GCM encrypted base32 secret
  enabled      Boolean   @default(false)
  lastUsedStep Int? // chống replay cùng 1 code
  createdAt    DateTime  @default(now())
  enabledAt    DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes RecoveryCode[]
}

model RecoveryCode {
  id       String    @id @default(uuid())
  totpId   String
  codeHash String // chỉ lưu hash, không lưu plaintext
  usedAt   DateTime?

  totp UserTotp @relation(fields: [totpId], references: [id], onDelete: Cascade)
}

// ═══════ Admin: security events ═══════
model SecurityEvent {
  id        String   @id @default(uuid())
  type      String // RECAPTCHA_REJECT, HIBP_BLOCK, TOTP_FAIL, RECOVERY_USED, ANOMALY_ALERT
  userId    String?
  ip        String?
  metadata  Json? // chi tiết thêm (score, reason...)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([createdAt])
}

// ═══════ User notes / todos ═══════
model Todo {
  id          String    @id @default(uuid())
  userId      String
  title       String    @db.VarChar(255)
  note        String?   @db.Text
  status      String    @default("pending") // pending | in_progress | done
  priority    String    @default("medium") // low | medium | high
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

// ═══════ Project dashboard ═══════
enum CriteriaStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum CriteriaPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  NEEDS_ATTENTION
}

model ProjectConfig {
  id          String        @id @default(uuid())
  name        String // tên dự án, ví dụ "Paper & Progress"
  description String? // mô tả ngắn
  health      ProjectHealth @default(ON_TRACK)
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
}

model CriteriaCategory {
  id          String   @id @default(uuid())
  name        String // "Frontend (Next.js)", "Backend (NestJS)"...
  description String? // "UI, responsive, routing..."
  icon        String? // tên icon để frontend render
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criteria ProjectCriteria[]

  @@index([sortOrder])
}

model ProjectCriteria {
  id              String           @id @default(uuid())
  categoryId      String
  title           String
  description     String?          @db.Text
  status          CriteriaStatus   @default(NOT_STARTED)
  priority        CriteriaPriority @default(MEDIUM)
  deadline        DateTime?
  needsReview     Boolean          @default(false)
  needsDiscussion Boolean          @default(false)
  notes           String?          @db.Text // development notes
  evidenceUrl     String? // GitHub URL hoặc link minh chứng
  completedAt     DateTime? // set khi status chuyển sang COMPLETED
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  category   CriteriaCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  activities ProjectActivity[]

  @@index([categoryId])
  @@index([status])
  @@index([deadline])
}

model ProjectActivity {
  id          String   @id @default(uuid())
  criteriaId  String?
  categoryId  String?
  type        String // STATUS_CHANGED, CRITERIA_CREATED, CRITERIA_UPDATED, CRITERIA_DELETED, CATEGORY_CREATED, CATEGORY_DELETED, NOTE_ADDED
  title       String // "Hoàn thành JWT Authentication"
  description String? // chi tiết thay đổi, ví dụ "NOT_STARTED → IN_PROGRESS"
  oldValue    String? // giá trị cũ (cho status change)
  newValue    String? // giá trị mới
  createdAt   DateTime @default(now())

  criteria ProjectCriteria? @relation(fields: [criteriaId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([criteriaId])
  @@index([type])
}

// ═══════ Daily English Gate ═══════
// Khoá platform cho tới khi user qua bài từ vựng hằng ngày (B2 Destination)

enum VocabSection {
  TOPIC_CONTRAST
  PHRASAL_VERB
  PHRASE_COLLOCATION
  WORD_PATTERN
  WORD_FORMATION
}

enum LessonType {
  NEW
  REVIEW
  FINAL_TEST
}

model VocabularyUnit {
  id         Int      @id @default(autoincrement())
  unitNumber Int      @unique // 2,4,6,...,28
  topic      String // "Travel and transport", ...
  createdAt  DateTime @default(now())

  words VocabularyWord[]
}

model VocabularyWord {
  id        Int          @id @default(autoincrement())
  unitId    Int
  section   VocabSection
  word      String // từ chính: "voyage", "catch up with", "have an accident"
  meaning   String // nghĩa tiếng Anh ngắn gọn
  example   String? // câu ví dụ, chứa nguyên văn `word`
  contrast  String? // các từ dễ nhầm (TOPIC_CONTRAST): "journey / trip / travel"
  forms     String? // các dạng từ (WORD_FORMATION): "arrival (noun)"
  pattern   String? // word pattern: "afraid of sth/doing; afraid to do"
  createdAt DateTime     @default(now())

  unit    VocabularyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reviews WordReview[]
  phrases Phrase[]

  @@index([unitId, section])
}

model DailyLesson {
  id        Int        @id @default(autoincrement())
  dayNumber Int        @unique // 1-30
  date      DateTime   @unique @db.Date // 1 ngày = 1 lesson
  type      LessonType
  unitIds   Int[] // id của VocabularyUnit học / ôn trong ngày
  createdAt DateTime   @default(now())

  progresses UserDailyProgress[]
}

model UserDailyProgress {
  id                Int       @id @default(autoincrement())
  userId            String
  lessonId          Int
  learnCompleted    Boolean   @default(false)
  practiceCompleted Boolean   @default(false)
  testCompleted     Boolean   @default(false)
  testScore         Int? // 0-100, điểm của lần làm test gần nhất
  bestScore         Int? // điểm cao nhất
  testAttempts      Int       @default(0) // số lần đã nộp test; đổi bộ câu hỏi mỗi lần
  gateUnlocked      Boolean   @default(false) // true khi test >= 70%
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson DailyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model WordReview {
  id         Int      @id @default(autoincrement())
  userId     String
  wordId     Int
  correct    Boolean
  reviewedAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, wordId])
}

/// Sổ cụm từ: người dùng tự lưu cụm từ rồi luyện 4 bước (đặt câu, nhớ lại, nói).
enum PhraseStage {
  WRITE // chưa đặt câu (bước 2)
  RECALL // đến lượt nhớ lại (bước 3)
  SPEAK // đến lượt luyện nói (bước 4)
  MASTERED
}

enum PhraseExampleStep {
  WRITE // bước 2
  RECALL // bước 3
}

model Phrase {
  id               String      @id @default(uuid())
  userId           String
  wordId           Int? // cụm lấy từ bài học; null nếu người dùng tự thêm
  phrase           String // "meet a deadline"
  phraseNormalized String // trim + lowercase + gộp khoảng trắng, để chống trùng
  meaning          String // người dùng tự viết: nghĩa / gợi nhớ
  sampleSentence   String?
  stage            PhraseStage @default(WRITE)
  intervalDays     Int         @default(0)
  nextReviewAt     DateTime    @db.Date // service tự gán theo "hôm nay" của Daily Gate
  easyStreak       Int         @default(0) // số lần "Dễ" liên tiếp
  speakPassed      Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  word     VocabularyWord?       @relation(fields: [wordId], references: [id], onDelete: SetNull)
  examples PhraseExample[]
  attempts PhraseSpokenAttempt[]
  reviews  PhraseReview[]

  @@unique([userId, phraseNormalized])
  @@index([userId, stage, nextReviewAt])
}

model PhraseExample {
  id        Int               @id @default(autoincrement())
  phraseId  String
  text      String
  step      PhraseExampleStep
  isCorrect Boolean? // để dành cho chấm bằng AI
  feedback  String? // để dành cho chấm bằng AI
  usedHint  Boolean           @default(false)
  createdAt DateTime          @default(now())

  phrase Phrase @relation(fields: [phraseId], references: [id], onDelete: Cascade)

  @@index([phraseId])
}

enum PhraseGrade {
  FORGOT
  HARD
  EASY
}

/// Một dòng cho mỗi lần nhớ lại (bước 3) mà server đã chấp nhận; để lịch học tổng hợp theo ngày.
model PhraseReview {
  id        Int         @id @default(autoincrement())
  phraseId  String
  grade     PhraseGrade
  usedHint  Boolean     @default(false)
  createdAt DateTime    @default(now())

  phrase Phrase @relation(fields: [phraseId], references: [id], onDelete: Cascade)

  @@index([phraseId])
  @@index([createdAt])
}

model PhraseSpokenAttempt {
  id             Int      @id @default(autoincrement())
  phraseId       String
  transcript     String
  containsPhrase Boolean
  createdAt      DateTime @default(now())

  phrase Phrase @relation(fields: [phraseId], references: [id], onDelete: Cascade)

  @@index([phraseId])
}

/// Một dòng cho mỗi ngày người dùng có hành động trong sổ cụm từ; dùng tính streak.
model PhraseActivityDay {
  userId String
  day    DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// ---------------------------------------------------------------------------
// Articles
// ---------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ArticleVisibility {
  PUBLIC
  PREVIEW
  MEMBERS_ONLY
}

enum ArticleType {
  TUTORIAL
  LEARNING_NOTES
  EXPERIENCE
  OPINION
  CASE_STUDY
  REVIEW
}

enum ReactionType {
  LIKE
  LOVE
  INSIGHTFUL
  CELEBRATE
}

model Article {
  id             String            @id @default(uuid())
  slug           String            @unique
  title          String            @db.VarChar(200)
  excerpt        String?           @db.VarChar(400)
  coverImageUrl  String?
  contentJson    Json // TipTap JSON, nguồn sự thật
  contentHtml    String            @db.Text // đã sanitize, dùng để render
  contentText    String            @db.Text // text thuần, để tính reading time và search
  readingMinutes Int               @default(1)
  articleType    ArticleType       @default(LEARNING_NOTES)
  status         ArticleStatus     @default(DRAFT)
  visibility     ArticleVisibility @default(PUBLIC)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  authorId       String
  seriesId       String?
  seriesOrder    Int?
  viewCount      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  // searchVector (tsvector, generated) nằm trong migration SQL, Prisma không biết cột này.

  author    User              @relation(fields: [authorId], references: [id])
  series    Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  tags      ArticleTag[]
  topics    ArticleTopic[]
  comments  Comment[]
  reactions Reaction[]
  bookmarks Bookmark[]
  revisions ArticleRevision[]
  views     ArticleView[]

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([seriesId, seriesOrder])
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Series {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String?
  articles    Article[]
}

model Comment {
  id        String   @id @default(uuid())
  articleId String
  userId    String
  parentId  String?
  body      String   @db.Text
  isDeleted Boolean  @default(false) // xoá mềm để không gãy cây trả lời
  createdAt DateTime @default(now())

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Replies")

  @@index([articleId, createdAt])
}

model Reaction {
  articleId String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId, type])
  @@index([userId])
}

model Bookmark {
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
  @@index([userId, createdAt])
}

model ArticleRevision {
  id          String   @id @default(uuid())
  articleId   String
  title       String
  contentJson Json
  contentHtml String   @db.Text
  contentText String   @db.Text // để so sánh khác biệt giữa các bản
  createdById String
  createdAt   DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

model ArticleView {
  id               String   @id @default(uuid())
  articleId        String
  userId           String?
  maxScrollPercent Int      @default(0) // 0/25/50/75/100
  createdAt        DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

// ---------------------------------------------------------------------------
// Knowledge Library
// ---------------------------------------------------------------------------

/// Lĩnh vực (cha rỗng) và danh mục con của nó, ví dụ "Công nghệ thông tin" > "Frontend".
model KnowledgeCategory {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  /// Khoá icon, client ánh xạ sang component.
  icon        String  @default("book")
  order       Int     @default(0)
  parentId    String?

  parent   KnowledgeCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children KnowledgeCategory[] @relation("CategoryTree")
  topics   Topic[]

  @@index([parentId, order])
}

/// Một chủ đề kiến thức, ví dụ React. Article và Learning Path liên kết tới Topic, không nhân bản nội dung.
model Topic {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  icon        String  @default("code")
  /// Nhóm trong danh mục con, ví dụ "Framework", "Ngôn ngữ".
  groupLabel  String?
  order       Int     @default(0)
  categoryId  String

  category  KnowledgeCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  resources KnowledgeResource[]
  articles  ArticleTopic[]
  paths     LearningPathTopic[]
  followers TopicFollow[]

  @@index([categoryId, order])
}

/// Tài liệu tham khảo của một Topic. `url` bắt đầu bằng "/" là nội bộ, còn lại là liên kết ngoài.
model KnowledgeResource {
  id          String  @id @default(uuid())
  topicId     String
  title       String
  url         String
  description String?
  order       Int     @default(0)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, order])
}

model TopicFollow {
  userId    String
  topicId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([userId, createdAt])
}

model ArticleTopic {
  articleId String
  topicId   String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([articleId, topicId])
  @@index([topicId])
}

// ---------------------------------------------------------------------------
// Learning Paths
// ---------------------------------------------------------------------------

enum LearningLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PathStatus {
  DRAFT
  PUBLISHED
}

model LearningPath {
  id               String         @id @default(uuid())
  slug             String         @unique
  title            String
  description      String         @db.Text
  level            LearningLevel?
  /// Chỉ điền khi có dữ liệu thật; không suy ra từ số bước.
  estimatedMinutes Int?
  objectives       String[]
  prerequisites    String[]
  outcomes         String[]
  status           PathStatus     @default(PUBLISHED)
  order            Int            @default(0)
  createdAt        DateTime       @default(now())

  topics   LearningPathTopic[]
  phases   LearningPhase[]
  steps    LearningStep[]
  progress UserPathProgress[]

  @@index([status, order])
}

model LearningPathTopic {
  pathId  String
  topicId String

  path  LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  topic Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([pathId, topicId])
  @@index([topicId])
}

model LearningPhase {
  id          String  @id @default(uuid())
  pathId      String
  order       Int
  title       String
  description String?

  path  LearningPath   @relation(fields: [pathId], references: [id], onDelete: Cascade)
  steps LearningStep[]

  @@unique([pathId, order])
}

model LearningStep {
  id              String @id @default(uuid())
  pathId          String
  phaseId         String
  /// Thứ tự trong cả lộ trình (1, 2, 3...), dùng cho "bước tiếp theo".
  order           Int
  slug            String
  title           String
  durationMinutes Int?
  heading         String
  lead            String @db.Text
  /// Các khối nội dung (cùng dạng với Step Tutor: hộp, đoạn, danh sách, mã, checklist).
  content         Json

  path     LearningPath       @relation(fields: [pathId], references: [id], onDelete: Cascade)
  phase    LearningPhase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  progress UserStepProgress[]

  @@unique([pathId, slug])
  @@unique([pathId, order])
}

model UserPathProgress {
  userId     String
  pathId     String
  startedAt  DateTime @default(now())
  lastStepId String?
  updatedAt  DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@id([userId, pathId])
}

/// Tiến độ, checklist và ghi chú của một người ở một bước.
model UserStepProgress {
  userId      String
  stepId      String
  completedAt DateTime?
  /// { [checkId]: boolean }
  checks      Json      @default("{}")
  note        String?   @db.Text
  updatedAt   DateTime  @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  step LearningStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@id([userId, stepId])
  @@index([stepId])
}
